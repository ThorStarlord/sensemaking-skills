      "id": "domain_concept:considered-choice-set",
      "kind": "domain_concept",
      "statement": "A ConsideredChoiceSet preserves source-qualified credible alternatives and their omissions under one decision frame; nonselected, overlapping, status quo and incomparable members remain distinct.",
      "authority_kind": "document",
      "authority_ref": "docs/semantic-architecture/convergent-direction-selection-ontology.md",
      "evidence_refs": [
        "file:docs/semantic-architecture/convergent-direction-selection-ontology.md"
