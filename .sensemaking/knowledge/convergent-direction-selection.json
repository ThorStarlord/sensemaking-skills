      "epistemic_status": "declared"
    },
    {
      "id": "domain_concept:candidate-warrant",
      "kind": "domain_concept",
      "statement": "CandidateWarrant is an attributed, defeasible argument for pursuing one typed target at all, naming prerequisites, supporting and defeating evidence, currentness, consequences and authority; being preferred is insufficient.",
      "authority_kind": "document",
      "authority_ref": "docs/semantic-architecture/convergent-direction-selection-ontology.md",
      "evidence_refs": [
        "file:docs/semantic-architecture/convergent-direction-selection-ontology.md"
      ],
      "epistemic_status": "declared"
    },
    {
      "id": "domain_concept:convergence-rationale",
      "kind": "domain_concept",
      "statement": "ConvergenceRationale explains why a candidate with sufficient warrant better serves the declared choice question than credible alternatives, with qualitative tradeoffs, counterevidence and reconsideration conditions.",
      "authority_kind": "document",
      "authority_ref": "docs/semantic-architecture/convergent-direction-selection-ontology.md",
      "evidence_refs": [
        "file:docs/semantic-architecture/convergent-direction-selection-ontology.md"
      ],
      "epistemic_status": "declared"
    },
    {
      "id": "domain_concept:scoped-direction-selection",
      "kind": "domain_concept",
      "statement": "ScopedDirectionSelection denotes the role of an actual actor- and authority-backed Decision selecting an existing typed target within an explicit scope; it is not a copied target, mere recommendation, automatic product adoption or execution permission.",
      "authority_kind": "document",
      "authority_ref": "docs/semantic-architecture/convergent-direction-selection-ontology.md",
      "evidence_refs": [
        "file:docs/semantic-architecture/convergent-direction-selection-ontology.md"
      ],
      "epistemic_status": "declared"
    },
    {
      "id": "domain_concept:alternative-disposition-account",
      "kind": "domain_concept",
      "statement": "AlternativeDispositionAccount explains what happened to each considered nonselected target within a scoped choice: deferred, declined for that purpose, complementary, outside-frame, superseded, defeated or not assessed; original identity persists.",
      "authority_kind": "document",
      "authority_ref": "docs/semantic-architecture/convergent-direction-selection-ontology.md",
      "evidence_refs": [
        "file:docs/semantic-architecture/convergent-direction-selection-ontology.md"
      ],
      "epistemic_status": "declared"
    },
    {
      "id": "domain_concept:selection-reconsideration-boundary",
      "kind": "domain_concept",
      "statement": "SelectionReconsiderationBoundary identifies changes in decisive prerequisites, evidence, owner intention, currentness or consequences warranting a new assessment of a historical selection, without automatically undoing that selection.",
      "authority_kind": "document",
      "authority_ref": "docs/semantic-architecture/convergent-direction-selection-ontology.md",
      "evidence_refs": [
        "file:docs/semantic-architecture/convergent-direction-selection-ontology.md"
      ],
      "epistemic_status": "declared"
    },
    {
      "id": "domain_concept:selection-handoff",
      "kind": "domain_concept",
      "statement": "SelectionHandoff is a bounded documentary continuation reference recording a selected target, authority, accepted constraints, unsettled questions and prerequisites that later agents should recheck; it is not an executable task or new artifact requirement.",
      "authority_kind": "document",
      "authority_ref": "docs/semantic-architecture/convergent-direction-selection-ontology.md",
      "evidence_refs": [
