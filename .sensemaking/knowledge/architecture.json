    {
      "id": "observation:legacy-brief-producer-bypasses-runtime-paths",
      "kind": "observation",
      "statement": "At aa13f40 (2026-10-23), SkillsOrchestrator.run_repo_sensemaker_skill() wrote a generated file inventory to <project_root>/artifacts/repository_sensemaking_brief.md through PathResolver.artifact_path; on a disposable clone it replaced the tracked brief with content failing validate-brief.py and returned success true with authority authorized_autonomously.",
      "authority_kind": "document",
      "authority_ref": "artifacts/history/2026-10-23-repository-sensemaking-brief-observation.md",
      "evidence_refs": [
        "file:artifacts/history/2026-10-23-repository-sensemaking-brief-observation.md",
        "file:tests/test_legacy_repo_sensemaker_fail_closed.py"
      ],
      "epistemic_status": "observed",
      "attributes": {
        "examined_revision": "aa13f40115b52f9e7687d742cbc8430d5a9a4a25",
        "scope": "Historical: behaviour before the 2026-10-25 fail-closed repair, not the current producer. The validator errors were content-level, so a path fix alone would not have made the brief contract-valid."
      }
    },
    {
      "id": "decision:legacy-brief-producer-fails-closed",
      "kind": "decision",
      "statement": "Owner decision on Q-1 (2026-10-25): keep the legacy brief producer's API importable but make it fail closed. Removing it, keeping it as is, and routing its write through a runtime-supplied path were not chosen; a path fix alone would still write contract-invalid content.",
      "authority_kind": "owner",
      "authority_ref": ".sensemaking/receipts/2026-10-25-legacy-brief-producer-fail-closed.session.yaml",
      "evidence_refs": [
        "file:src/sensemaking_skills/skills/repo_sensemaker.py",
        "file:API.md",
        "file:tests/test_legacy_repo_sensemaker_fail_closed.py"
      ],
      "epistemic_status": "declared",
      "attributes": {
        "question_ref": "2026-10-23-observe-skills#Q-1",
        "scope": "Legacy RepoSensemakerSkill only; the legacy WorkflowPlannerSkill is not covered"
      }
    },
    {
      "id": "verification:legacy-brief-producer-fail-closed-tests",
